" as="geometry"><mxPoint x="12.0" y="-11.0" as="offset"/></mxGeometry></mxCell><mxCell id="e232" value="" style="endArrow=block;endFill=0;endSize=14;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4b5563;strokeWidth=1.2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="c144" target="c112"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="855.5" y="1775.5"/><mxPoint x="855.5" y="1788.0"/></Array></mxGeometry></mxCell><mxCell id="e233" value="" style="endArrow=block;endFill=0;endSize=14;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4b5563;strokeWidth=1.2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="c148" target="c112"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="855.5" y="1928.0"/><mxPoint x="855.5" y="1924.8"/></Array></mxGeometry></mxCell><mxCell id="e234" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#6b7280;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="c80" target="c96"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1423.0" y="899.5"/><mxPoint x="1423.0" y="1077.0"/></Array></mxGeometry></mxCell><mxCell id="c235" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;POLYMORPHISM&lt;/b&gt;&lt;br&gt;Game never asks a customer&amp;#x27;s type. Loss rate, food choice, bill and paying remark are dispatched to the subclass (Stage 2)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="285.0" y="1640.0" width="230.0" height="68.0" as="geometry"/></mxCell><mxCell id="e236" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0;entryY=0.4;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c235" target="c112"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c237" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;ENCAPSULATION + COMPOSITION&lt;/b&gt;&lt;br&gt;Restaurant owns its tables and orders and is the only object that moves a customer between queue, table and door (the ~ methods). Its lists are handed out read-only." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720.0" y="1350.0" width="330.0" height="82.0" as="geometry"/></mxCell><mxCell id="e238" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=1;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c237" target="c100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c239" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;TEMPLATE METHOD&lt;/b&gt;&lt;br&gt;perform() checks the task budget and duty, then calls carryOut(). A broken rule throws RuleViolation, so the task is not used up." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480.0" y="1075.0" width="330.0" height="68.0" as="geometry"/></mxCell><mxCell id="e240" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0.2;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c239" target="c72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c241" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;STAGE 2 (tag stage-2): changes from Stage 1&lt;/b&gt;&lt;br&gt;NEW: VIPCustomer and CriticCustomer extend Customer and override only the hooks that differ (loss rate, bill, food choice, remark). ADDED: Money.percent(int) for the VIP 10% discount. No other class shown here changed: GameConfig only makes guest 2 (Ben) a Critic and guest 3 (Chloe) a VIP." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1845.0" y="250.0" width="520.0" height="96.0" as="geometry"/></mxCell><mxCell id="c242" value="Visibility: + public &amp;nbsp; - private &amp;nbsp; # protected &amp;nbsp; ~ package. Italic = abstract, underlined = static." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1660.0" y="2045.0" width="560.0" height="16.0" as="geometry"/></mxCell><mxCell id="e243" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660.0" y="2075.0" as="sourcePoint"/><mxPoint x="1712.0" y="2075.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c244" value="generalisation" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720.0" y="2067.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e245" value="" style="endArrow=block;endFill=0;endSize=14;dashed=1;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1855.0" y="2075.0" as="sourcePoint"/><mxPoint x="1907.0" y="2075.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c246" value="realisation" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1915.0" y="2067.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e247" value="" style="startArrow=diamondThin;startFill=1;startSize=18;endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2050.0" y="2075.0" as="sourcePoint"/><mxPoint x="2102.0" y="2075.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c248" value="composition" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2110.0" y="2067.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e249" value="" style="startArrow=diamondThin;startFill=0;startSize=18;endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660.0" y="2097.0" as="sourcePoint"/><mxPoint x="1712.0" y="2097.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c250" value="aggregation" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720.0" y="2089.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e251" value="" style="endArrow=open;endSize=10;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1855.0" y="2097.0" as="sourcePoint"/><mxPoint x="1907.0" y="2097.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c252" value="association" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1915.0" y="2089.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e253" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2050.0" y="2097.0" as="sourcePoint"/><mxPoint x="2102.0" y="2097.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c254" value="dependency" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2110.0" y="2089.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e255" value="" style="endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660.0" y="2119.0" as="sourcePoint"/><mxPoint x="1712.0" y="2119.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c256" value="association, both ways" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720.0" y="2111.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="c257" value="«record» components are shown as + read-only properties: Java gives each a private final field&lt;br&gt;and a public accessor. Getters, toString(), most constructors and most private helpers are left out.&lt;br&gt;Nested types used as member types: ArrivalSchedule.Arrival «record», ArrivalSchedule.CustomerFactory&lt;br&gt;«interface», GameResult.Target «record», Cashier.Payment «record», CommandParser.Input «record»." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6b7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30.0" y="2060.0" width="560.0" height="64.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
